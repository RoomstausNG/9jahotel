{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "9jahotel",
  "version": "1.1.1",
  "identifier": "v1.myroomstatus.com",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run generate",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "title": "9jahotel",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 28,
      "versionCode": 100
    },
    "iOS": {
      "bundleVersion": "100"
    }
  }
}